  {
   "set": "stage",
   "say": "Planning was born in 1974, in Stephen King's Planning Guide at JWT London. A method must stimulate imagination, not just control it: realistic, pragmatic, fundamental and structured.",
   "board": {
    "title": "King's **four rules**",
    "steps": [
     {
      "text": "**Realistic** based in practice",
      "cue": "realistic",
      "at": 9.368
     },
     {
      "text": "**Pragmatic** simple, memorable",
      "cue": "pragmatic",
      "at": 10.193
     },
     {
      "text": "**Fundamental** real theory",
      "cue": "fundamental",
      "at": 10.995
     },
     {
      "text": "**Structured** a frame for imagination",
      "cue": "structured",
      "at": 11.939
