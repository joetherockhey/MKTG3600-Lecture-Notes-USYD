 { "set": "stage", "say": "The format is five short essay or scenario questions, six marks each, thirty marks in total. Answer every part, a, b and so on.",
   "board": { "title": "The **format**", "big": "5 x 6", "caption": "= **30 marks** in total", "cue": "five" },
   "cast": [ { "id": "host", "look": "host", "at": "board", "pose": "point" }, { "id": "s1", "look": "student", "v": 6, "at": "aisle", "hold": "laptop", "pose": "hold" } ],
